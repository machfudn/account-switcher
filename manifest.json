{
  "manifest_version": 3,
  "name": "Account Switcher",
  "version": "2.0.0",
  "description": "Switch between multiple accounts for ChatGPT, Claude, Gemini, Canva, Perplexity, Poe, Copilot, Grok, DeepSeek, HuggingChat, Cursor, and NotebookLM",
  "permissions": [
    "storage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.openai.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://canva.com/*",
    "https://*.canva.com/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://poe.com/*",
    "https://*.poe.com/*",
    "https://copilot.microsoft.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://cursor.com/*",
    "https://*.cursor.com/*",
    "https://notebooklm.google.com/*",
    "https://*.notebooklm.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
