{
  "manifest_version": 3,
  "name": "Account Switcher",
  "version": "2.0.0",
  "description": "Switch between multiple accounts for ChatGPT, Claude, Gemini, Canva, Perplexity, Poe, Copilot, Grok, DeepSeek, HuggingChat, Cursor, NotebookLM, Notion, Figma, GitHub, Slack, Vercel, Midjourney, Runway, v0, Lovable, Replit, Netflix, Disney+, Prime Video, Max, Hulu, Crunchyroll, Viu, WeTV, Hotstar, Bstation, WhatsApp, Lark, Facebook, Spotify, Deezer, SoundCloud, Tidal, Pandora, and Bandcamp",
  "permissions": [
    "storage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.openai.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "https://canva.com/*",
    "https://*.canva.com/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://poe.com/*",
    "https://*.poe.com/*",
    "https://copilot.microsoft.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://cursor.com/*",
    "https://*.cursor.com/*",
    "https://notebooklm.google.com/*",
    "https://*.notebooklm.google.com/*",
    "https://notion.so/*",
    "https://*.notion.so/*",
    "https://notion.site/*",
    "https://*.notion.site/*",
    "https://figma.com/*",
    "https://*.figma.com/*",
    "https://github.com/*",
    "https://*.github.com/*",
    "https://slack.com/*",
    "https://*.slack.com/*",
    "https://vercel.com/*",
    "https://*.vercel.com/*",
    "https://midjourney.com/*",
    "https://*.midjourney.com/*",
    "https://runwayml.com/*",
    "https://*.runwayml.com/*",
    "https://v0.dev/*",
    "https://*.v0.dev/*",
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://replit.com/*",
    "https://*.replit.com/*",
    "https://netflix.com/*",
    "https://*.netflix.com/*",
    "https://disneyplus.com/*",
    "https://*.disneyplus.com/*",
    "https://primevideo.com/*",
    "https://*.primevideo.com/*",
    "https://max.com/*",
    "https://*.max.com/*",
    "https://hulu.com/*",
    "https://*.hulu.com/*",
    "https://crunchyroll.com/*",
    "https://*.crunchyroll.com/*",
    "https://viu.com/*",
    "https://*.viu.com/*",
    "https://wetv.com/*",
    "https://*.wetv.com/*",
    "https://hotstar.com/*",
    "https://*.hotstar.com/*",
    "https://bilibili.tv/*",
    "https://*.bilibili.tv/*",
    "https://whatsapp.com/*",
    "https://*.whatsapp.com/*",
    "https://larksuite.com/*",
    "https://*.larksuite.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://open.spotify.com/*",
    "https://*.open.spotify.com/*",
    "https://spotify.com/*",
    "https://*.spotify.com/*",
    "https://deezer.com/*",
    "https://*.deezer.com/*",
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "https://tidal.com/*",
    "https://*.tidal.com/*",
    "https://pandora.com/*",
    "https://*.pandora.com/*",
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
